              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Build PUT body (fill missing PID/DID)" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// Reads the storer-key detail response, fills in any MISSING DID/PID config,
// and prepares the PUT body (same shape the UI sends).
vars.put(&quot;needs_config&quot;, &quot;false&quot;)
vars.put(&quot;put_body&quot;, &quot;&quot;)
try {
    def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def d = root.data
    def need = false
    def blank = { v -&gt; v == null || v.toString().trim().isEmpty() }
    def fill = { String field, String varName -&gt;
        if (blank(d[field])) { d[field] = vars.get(varName); need = true }
    }
    fill(&quot;did_prefix&quot;, &quot;DID_PREFIX&quot;)
    fill(&quot;did_start_number&quot;, &quot;DID_START&quot;)
    fill(&quot;pid_prefix&quot;, &quot;PID_PREFIX&quot;)
    fill(&quot;pid_start_number&quot;, &quot;PID_START&quot;)

    // detail returns nested objects, PUT wants plain ids
    [&quot;client&quot;, &quot;hub&quot;, &quot;cc_code&quot;].each { k -&gt;
        if (d[k] instanceof Map) { d[k] = d[k].id }
    }
    d.remove(&quot;service_type&quot;)          // not part of the PUT body in the HAR
    def tz = vars.get(&quot;TIMEZONE_OVERRIDE&quot;)
    if (tz != null &amp;&amp; !tz.trim().isEmpty()) { d.timezone = tz }

    vars.put(&quot;current_code&quot;, d.storerkey_code as String)
    vars.put(&quot;needs_config&quot;, need.toString())
    vars.put(&quot;put_body&quot;, JsonOutput.toJson(d))
    log.info(&quot;Storer &quot; + d.storerkey_code + &quot; needs PID/DID config: &quot; + need)
} catch (Exception e) {
    log.error(&quot;Could not parse storer detail: &quot; + e)
}
</stringProp>
