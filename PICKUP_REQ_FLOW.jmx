                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="script">String responseCode = prev.getResponseCode()
String responseBody = prev.getResponseDataAsString()

int retryCount = vars.get(&apos;retryCount&apos;).toInteger() + 1

vars.put(&apos;LAST&apos;, responseCode)
vars.put(&apos;retryCount&apos;, retryCount.toString())

log.info(&apos;========== PO API RESPONSE ==========&apos;)
log.info(&apos;Thread: &apos; + ctx.getThread().getThreadName())
log.info(&apos;Attempt number: &apos; + retryCount)
log.info(&apos;PO used: &apos; + vars.get(&apos;purchase_orders&apos;))
log.info(&apos;Response code: &apos; + responseCode)
log.info(&apos;Response body: &apos; + responseBody)
log.info(&apos;Stored LAST value: &apos; + vars.get(&apos;LAST&apos;))

if (responseCode == &apos;200&apos;) {
    log.info(&apos;SUCCESS: PO API returned 200&apos;)
    log.info(&apos;While Controller will exit&apos;)
    log.info(&apos;JMeter will continue to STEP_2&apos;)
} else if (responseCode == &apos;400&apos;) {
    log.warn(&apos;RETRY: PO API returned 400&apos;)
    log.warn(&apos;While Controller will execute again with another PO&apos;)
} else {
    log.error(&apos;UNEXPECTED RESPONSE CODE: &apos; + responseCode)
}</stringProp>
                    <stringProp name="scriptLanguage">groovy</stringProp>
                  </JSR223PostProcessor>
